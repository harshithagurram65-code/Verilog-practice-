
module or_gate(
    input a,
    input b,
    output y
);

assign y = a | b;

endmodule

module or_gate_tb;

reg a, b;
wire y;

or_gate dut (
    .a(a),
    .b(b),
    .y(y)
);

initial begin
    a = 0; b = 0;
    #10;
    a = 0; b = 1;
    #10;
    a = 1; b = 0;
    #10;
    a = 1; b = 1;
    #10;
    $finish;
end

initial begin
    $monitor("Time=%0t a=%b b=%b y=%b", $time, a, b, y);
end

endmodule
